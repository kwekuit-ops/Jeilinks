generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          String    @default("USER")
  balance       Decimal   @default(0)
  commissionBalance Decimal @default(0)
  storeSlug     String?   @unique
  createdAt     DateTime  @default(now())
  agentExpiry   DateTime?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  withdrawals   Withdrawal[]
  walletTransactions WalletTransaction[]
  customPrices  AgentBundlePrice[]
  oneSignalPlayerId String?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bundle {
  id                String   @id @default(cuid())
  network           String
  size              String
  userPrice         Decimal
  agentPrice        Decimal
  supplierProductId String?
  supplierPrice     Decimal?
  isActive          Boolean            @default(true)
  orders            Order[]
  customPrices      AgentBundlePrice[]
  mappings          SupplierMapping[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
}

model SupplierMapping {
  id                String   @id @default(cuid())
  bundleId          String
  bundle            Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  supplierType      String // e.g. "FUZESERVE", "MYSOCIALBOOSTER"
  supplierProductId String
  supplierPrice     Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([bundleId, supplierType])
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  bundleId        String
  phone           String
  amount          Decimal
  status          String   @default("PENDING")
  paystackRef     String?  @unique
  paymentMethod   String   @default("PAYSTACK")
  supplierOrderId String?
  supplierStatus  String?
  agentId         String?
  commissionEarned Decimal @default(0)
  failureReason    String?
  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt
  bundle          Bundle   @relation(fields: [bundleId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal
  phone     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}
model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Decimal
  type          String   // "CREDIT", "DEBIT", "TOPUP"
  reference     String   @unique // Paystack reference or internal ID
  description   String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model AgentBundlePrice {
  id        String   @id @default(cuid())
  agentId   String
  bundleId  String
  customPrice Decimal
  
  agent     User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([agentId, bundleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
